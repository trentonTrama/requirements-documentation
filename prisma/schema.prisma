// Requirements management for insurtech product development.
//
// Structure mirrors how the requirement documents are actually written:
//
//   Category (domain) -> Journey (one document, read or write side)
//     -> FunctionalRequirement (grouped into sections)
//       -> AcceptanceCriterion
//
// Two orthogonal concepts cut across that tree:
//
//   Capability   what a requirement lets someone do -- the RBAC permission it
//                describes. Attaches to a journey and inherits down the chain.
//   Role         a configured bundle of capabilities (Underwriter = view policy
//                + change policy). Roles never attach to requirements directly;
//                a role reaches a requirement through the capabilities it grants.
//   Project      a cross-cutting collection of domains, journeys and individual
//                requirements -- a release, a workstream, a statement of work.
//
// Capability assignment inherits down the document chain. Capabilities attach to
// a Journey; a requirement inherits them unless it declares its own; a criterion
// inherits the requirement's resolved set unless it declares its own. A non-empty
// capabilities relation IS the override at each level -- there is deliberately no
// separate boolean to keep in sync.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum RequirementStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  IMPLEMENTED
  DEPRECATED
}

enum Priority {
  MUST
  SHOULD
  COULD
  WONT
}

enum QuestionStatus {
  OPEN
  ANSWERED
  DEFERRED
}

enum LinkType {
  DEPENDS_ON
  RELATES_TO
  CONFLICTS_WITH
}

/// Whether a journey document covers reading the surface or changing it.
enum JourneySide {
  READ
  WRITE
}

/// How a change reaches the policy. Set per requirement section on write journeys.
enum ChangeClass {
  POLICY_CHANGE
  SERVICING_UPDATE
  CONTAINER
}

enum NoteKind {
  DECISION
  TECHNICAL
}

/// The verb half of a capability: what the holder may do to the resource.
enum CapabilityAction {
  VIEW
  CREATE
  UPDATE
  DELETE
  APPROVE
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  PAUSED
  COMPLETE
}

/// One permission: an action on a resource ("update the policy's coverage").
/// Requirements are written against capabilities, not against roles, so the same
/// requirement stays correct when a role's configuration changes.
model Capability {
  id          String           @id @default(cuid())
  key         String           @unique
  name        String
  description String           @default("")
  /// What the capability acts on, e.g. "Policy coverage & rating".
  resource    String           @default("")
  action      CapabilityAction @default(VIEW)
  color       String           @default("slate")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  roles              Role[]                  @relation("RoleCapabilities")
  journeys           Journey[]               @relation("JourneyCapabilities")
  requirements       FunctionalRequirement[] @relation("RequirementCapabilities")
  acceptanceCriteria AcceptanceCriterion[]   @relation("CriterionCapabilities")

  @@index([name])
  @@index([action])
}

/// A configured set of capabilities -- who the product is built for, expressed as
/// what they are allowed to do. Editing a role's capabilities immediately changes
/// which requirements it reaches; no requirement has to be touched.
model Role {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String   @default("")
  goals       String   @default("")
  painPoints  String   @default("")
  color       String   @default("slate")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  capabilities Capability[] @relation("RoleCapabilities")

  @@index([sortOrder])
  @@index([name])
}

/// A cross-cutting collection: a release, workstream or statement of work.
/// Membership is deliberately many-to-many at three levels -- a project can take a
/// whole domain, a single journey document, or one requirement out of a document --
/// so a project can slice the tree without owning any part of it.
model Project {
  id          String        @id @default(cuid())
  key         String        @unique
  slug        String        @unique
  name        String
  description String        @default("")
  status      ProjectStatus @default(ACTIVE)
  color       String        @default("slate")
  sortOrder   Int           @default(0)
  startsOn    DateTime?
  targetDate  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  categories   Category[]              @relation("ProjectCategories")
  journeys     Journey[]               @relation("ProjectJourneys")
  requirements FunctionalRequirement[] @relation("ProjectRequirements")

  @@index([status])
  @@index([sortOrder])
}

/// A domain. Journeys belong to one; requirements reach it through their journey.
model Category {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String   @default("")
  color       String   @default("slate")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  journeys Journey[]
  projects Project[] @relation("ProjectCategories")

  @@index([sortOrder])
}

/// One requirement document: a domain's read side or its write side.
model Journey {
  id         String      @id @default(cuid())
  slug       String      @unique
  /// Short handle used to build requirement references, e.g. BED -> FR-BED-001.
  key        String      @unique
  title      String
  side       JourneySide @default(READ)
  categoryId String

  statusNote    String @default("")
  author        String @default("")
  primarySource String @default("")
  docFile       String @default("")

  // The document's own user story.
  asA        String @default("")
  iWant      String @default("")
  soThat     String @default("")
  covers     String @default("")
  notCovered String @default("")

  draftedOn DateTime?
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  category              Category                @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  capabilities          Capability[]            @relation("JourneyCapabilities")
  projects              Project[]               @relation("ProjectJourneys")
  requirements          FunctionalRequirement[]
  additionalUserStories AdditionalUserStory[]
  notes                 JourneyNote[]
  archiveItems          ArchiveItem[]
  comments              Comment[]
  questions             Question[]

  @@index([categoryId, sortOrder])
  @@index([side])
}

/// Extra user stories a document carries beyond its primary one.
model AdditionalUserStory {
  id          String       @id @default(cuid())
  journeyId   String
  changeClass ChangeClass?
  asA         String
  iWant       String
  soThat      String
  sortOrder   Int          @default(0)

  journey Journey @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  @@index([journeyId, sortOrder])
}

/// Decisions carried forward and technical notes, kept as written.
model JourneyNote {
  id        String   @id @default(cuid())
  journeyId String
  kind      NoteKind
  body      String
  sortOrder Int      @default(0)

  journey Journey @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  @@index([journeyId, kind, sortOrder])
}

/// Something from the archive deliberately not carried into this document, and where it went.
model ArchiveItem {
  id          String @id @default(cuid())
  journeyId   String
  item        String
  source      String @default("")
  disposition String @default("")
  sortOrder   Int    @default(0)

  journey Journey @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  @@index([journeyId, sortOrder])
}

model FunctionalRequirement {
  id        String @id @default(cuid())
  /// Stable human-readable reference (FR-BED-001). Assigned once, never rewritten --
  /// moving a requirement to another journey keeps its original reference.
  ref       String @unique
  journeyId String
  title     String

  description String            @default("")
  rationale   String            @default("")
  assumptions String            @default("")
  /// Where this requirement came from in the archive, and what changed since.
  sourceNotes String            @default("")
  status      RequirementStatus @default(DRAFT)
  priority    Priority          @default(SHOULD)

  /// The requirement group within the document, e.g. "Named entities".
  section              String       @default("")
  sectionOrder         Int          @default(0)
  /// Set when the whole section is state-specific, as opposed to this requirement alone.
  sectionStateSpecific Boolean      @default(false)
  changeClass          ChangeClass?
  /// Still awaiting a product or compliance decision.
  decisionRequired     Boolean      @default(false)
  /// Behaviour varies by state.
  stateSpecific        Boolean      @default(false)

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  journey            Journey               @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  /// Non-empty means this requirement overrides its journey's capabilities.
  capabilities       Capability[]          @relation("RequirementCapabilities")
  projects           Project[]             @relation("ProjectRequirements")
  acceptanceCriteria AcceptanceCriterion[]
  comments           Comment[]
  questions          Question[]
  linksFrom          RequirementLink[]     @relation("LinkFrom")
  linksTo            RequirementLink[]     @relation("LinkTo")

  @@index([journeyId, sectionOrder, sortOrder])
  @@index([status])
  @@index([priority])
  @@index([decisionRequired])
  @@index([stateSpecific])
}

model AcceptanceCriterion {
  id            String   @id @default(cuid())
  ref           String   @unique
  requirementId String
  statement     String
  notes         String   @default("")
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  requirement  FunctionalRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  /// Non-empty means this criterion overrides its requirement's resolved capabilities.
  capabilities Capability[]          @relation("CriterionCapabilities")
  comments     Comment[]
  questions    Question[]

  @@index([requirementId, sortOrder])
}

model Comment {
  id                    String   @id @default(cuid())
  body                  String
  authorName            String   @default("Anonymous")
  journeyId             String?
  requirementId         String?
  acceptanceCriterionId String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  journey             Journey?               @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  requirement         FunctionalRequirement? @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  acceptanceCriterion AcceptanceCriterion?   @relation(fields: [acceptanceCriterionId], references: [id], onDelete: Cascade)

  @@index([journeyId])
  @@index([requirementId])
  @@index([acceptanceCriterionId])
  @@index([createdAt])
}

model Question {
  id                    String         @id @default(cuid())
  body                  String
  askedBy               String         @default("Anonymous")
  status                QuestionStatus @default(OPEN)
  answer                String?
  answeredBy            String?
  answeredAt            DateTime?
  assignee              String?
  journeyId             String?
  requirementId         String?
  acceptanceCriterionId String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  journey             Journey?               @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  requirement         FunctionalRequirement? @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  acceptanceCriterion AcceptanceCriterion?   @relation(fields: [acceptanceCriterionId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([journeyId])
  @@index([requirementId])
  @@index([acceptanceCriterionId])
}

model RequirementLink {
  id                String   @id @default(cuid())
  fromRequirementId String
  toRequirementId   String
  type              LinkType @default(RELATES_TO)
  createdAt         DateTime @default(now())

  from FunctionalRequirement @relation("LinkFrom", fields: [fromRequirementId], references: [id], onDelete: Cascade)
  to   FunctionalRequirement @relation("LinkTo", fields: [toRequirementId], references: [id], onDelete: Cascade)

  @@unique([fromRequirementId, toRequirementId, type])
  @@index([toRequirementId])
}

model ChangeLogEntry {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  entityRef  String   @default("")
  entityName String   @default("")
  field      String
  oldValue   String   @default("")
  newValue   String   @default("")
  summary    String   @default("")
  authorName String   @default("System")
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

// Monotonic per-prefix counters so refs never collide and are never recycled
// after a delete.
model RefCounter {
  prefix    String @id
  nextValue Int    @default(1)
}
